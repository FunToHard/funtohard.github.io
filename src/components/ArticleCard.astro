---
interface Props { title: string; description: string; pubDate: Date; slug: string; category?: string; tags: string[]; type: 'research' | 'thoughts'; }
const { title, description, pubDate, slug, category, tags, type } = Astro.props;
const href = `/philosophy/${type}/${slug}/`;
---
<article class="publication-row" data-category={category || 'Thoughts'}>
  <div class="publication-meta"><span>{category || 'Reflection'}</span><time datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'})}</time><span>funtohard</span></div>
  <div class="publication-summary"><h3><a href={href}>{title}</a></h3><p>{description}</p><a class="publication-read" href={href}>Read {type === 'research' ? 'paper' : 'reflection'}<img src="/icons/arrow-right.svg" alt="" /></a></div>
  <div class="publication-subjects">{tags.slice(0,3).map(tag => <a href={`/philosophy/topics/${tag.toLowerCase().replace(/\s+/g,'-')}/`}>{tag}</a>)}</div>
</article>
