{
  "name": "funtohard",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "R-mergency"
  ],
  "scripts": {
    "dev": "astro dev --host",
    "dev:rmergency": "npm run dev --workspace=r-mergency",
