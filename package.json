    "astro": "^5.2.5",
    "katex": "^0.16.21",
    "pagefind": "^1.3.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
